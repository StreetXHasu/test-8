###> laravel/framework ###
APP_NAME="Image API"
APP_ENV=local
APP_KEY=__APP_KEY__
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
###< laravel/framework ###

###> laravel/logging ###
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
###< laravel/logging ###

###> laravel/database ###
DB_CONNECTION=pgsql
DB_URL=pgsql://app:app@127.0.0.1:54329/app
###< laravel/database ###

###> laravel/runtime ###
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
###< laravel/runtime ###

###> app/jwt ###
JWT_SECRET=__JWT_SECRET__
JWT_TTL=86400
###< app/jwt ###

###> app/garage ###
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=images
S3_ACCESS_KEY=__S3_ACCESS_KEY__
S3_SECRET_KEY=__S3_SECRET_KEY__
GARAGE_DEFAULT_ACCESS_KEY=__S3_ACCESS_KEY__
GARAGE_DEFAULT_SECRET_KEY=__S3_SECRET_KEY__
GARAGE_DEFAULT_BUCKET=images
GARAGE_RPC_SECRET=__GARAGE_RPC_SECRET__
GARAGE_ADMIN_TOKEN=__GARAGE_ADMIN_TOKEN__
GARAGE_METRICS_TOKEN=__GARAGE_METRICS_TOKEN__
###< app/garage ###
