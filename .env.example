###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=__APP_SECRET__
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:app@127.0.0.1:54329/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> app/jwt ###
JWT_SECRET=__JWT_SECRET__
JWT_TTL=86400
###< app/jwt ###

###> app/garage ###
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=images
S3_ACCESS_KEY=__S3_ACCESS_KEY__
S3_SECRET_KEY=__S3_SECRET_KEY__
GARAGE_DEFAULT_ACCESS_KEY=__S3_ACCESS_KEY__
GARAGE_DEFAULT_SECRET_KEY=__S3_SECRET_KEY__
GARAGE_DEFAULT_BUCKET=images
GARAGE_RPC_SECRET=__GARAGE_RPC_SECRET__
GARAGE_ADMIN_TOKEN=__GARAGE_ADMIN_TOKEN__
GARAGE_METRICS_TOKEN=__GARAGE_METRICS_TOKEN__
###< app/garage ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###
