#!/bin/sh
set -eu

cd "$(dirname "$0")/.."

force=0
if [ "${1:-}" = "--force" ]; then
    force=1
fi

if [ "$force" -eq 0 ] && [ -f .env.local ] && [ -f docker/garage/garage.toml ]; then
    echo "Secrets already exist: .env.local and docker/garage/garage.toml"
    exit 0
fi

app_key="base64:$(openssl rand -base64 32)"
jwt_secret="$(openssl rand -hex 32)"
s3_access_key="GK$(openssl rand -hex 16)"
s3_secret_key="$(openssl rand -hex 32)"
garage_rpc_secret="$(openssl rand -hex 32)"
garage_admin_token="$(openssl rand -hex 24)"
garage_metrics_token="$(openssl rand -hex 24)"

replace() {
    sed \
        -e "s|__APP_KEY__|${app_key}|g" \
        -e "s|__JWT_SECRET__|${jwt_secret}|g" \
        -e "s|__S3_ACCESS_KEY__|${s3_access_key}|g" \
        -e "s|__S3_SECRET_KEY__|${s3_secret_key}|g" \
        -e "s|__GARAGE_RPC_SECRET__|${garage_rpc_secret}|g" \
        -e "s|__GARAGE_ADMIN_TOKEN__|${garage_admin_token}|g" \
        -e "s|__GARAGE_METRICS_TOKEN__|${garage_metrics_token}|g" \
        "$1"
}

replace .env.example > .env.local
replace docker/garage/garage.toml.example > docker/garage/garage.toml
chmod 600 .env.local docker/garage/garage.toml

echo "Wrote .env.local and docker/garage/garage.toml"
